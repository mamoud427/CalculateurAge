<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="20" >
            <Label Text="Nom"
                   FontSize="16" />
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre Nom"/>
            <Label Text="Date de Naissance"
                   FontSize="16" />
            <DatePicker Date="{Binding DateNaissance}" />
            <Button Command="{Binding CalculerCommand}" Text="Calculer"
                     />
            <Label Text="{Binding Resultat}"
                   FontSize="20"
                   IsVisible="{Binding ResultatVisible}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
